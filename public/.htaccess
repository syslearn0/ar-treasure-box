# =====================================================================
#  WebAR — Apache 静的ホスティング用 .htaccess
#  Apache / 静的配信のみ。常駐プロセスは一切不要。
# =====================================================================

# --- HTTP → HTTPS 転送 -------------------------------------------------
# カメラ (getUserMedia) は HTTPS でしか動かないため必須。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- MIME タイプ -------------------------------------------------------
# 注: @8thwall/engine-binary 1.0.0 の dist に単独の .wasm ファイルは存在せず、
#     WASM は xr.js / xr-slam.js に埋め込まれている（2026-08 実測）。
#     .wasm の指定は将来のバージョン変更に備えた保険。
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/json .json
  AddType image/ktx2 .ktx2
  AddType image/webp .webp
  AddType text/javascript .js
  AddType font/woff2 .woff2
</IfModule>

# --- 圧縮 --------------------------------------------------------------
# .glb / .ktx2 / .webp は既に圧縮済みなので対象にしない。
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/wasm image/svg+xml
</IfModule>

# --- キャッシュ --------------------------------------------------------
<IfModule mod_headers.c>
  # Vite がハッシュを付けたアセットは不変として長期キャッシュ
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|glb|png|jpg|jpeg|webp|ktx2|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 8th Wall のエンジンはバージョン固定で入れ替え頻度が低い
  <FilesMatch "^(xr|xr-slam|xr-face|media-worker|semantics-worker)\.js$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # index.html は常に最新を取りに行かせる
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 画像ターゲットは差し替えやすいよう短命に
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

# --- ディレクトリ一覧を出さない ----------------------------------------
Options -Indexes
